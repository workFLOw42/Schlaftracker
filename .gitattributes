# Zeilenenden normalisieren: Textdateien immer als LF (im Repo und beim Checkout).
* text=auto eol=lf

# Gradle-Wrapper: gradlew MUSS LF behalten (sonst "bad interpreter" auf Linux-CI),
# die .bat MUSS CRLF behalten.
gradlew      text eol=lf
gradlew.bat  text eol=crlf
*.jar        binary

# Binaerdateien nie als Text behandeln.
*.png  binary
*.jpg  binary
*.webp binary
*.keystore binary
*.jks  binary
