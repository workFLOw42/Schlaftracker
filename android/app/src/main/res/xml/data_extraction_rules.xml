<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+ : Gesundheits- und Schlafdaten dürfen weder im Google-Cloud-Backup
    noch beim Gerätetransfer unverschlüsselt mitwandern. Dafür gibt es das
    passwortverschlüsselte Drive-Backup bzw. den JSON-Export.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="." />
    </device-transfer>
</data-extraction-rules>
